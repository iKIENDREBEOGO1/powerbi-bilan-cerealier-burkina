	partition 'Bilan céréalier' = m
		mode: import
		source =
				let
				    // Lecture du bilan céréalier annuel extrait de l'annuaire (une ligne par campagne)
				    #"Read balance file" = Csv.Document(File.Contents(#"Dossier données" & "bilan_cerealier_annuel.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted headers" = Table.PromoteHeaders(#"Read balance file", [PromoteAllScalars = true]),
				    #"Kept model columns" = Table.SelectColumns(#"Promoted headers", {"annee", "population_milliers", "disponibilites", "production_brute", "production_disponible", "stocks_initiaux", "besoins", "norme_kg_hbt", "consommation_humaine", "stocks_finaux", "excedent_brut", "solde_import_export", "importations_commerciales", "aides_alimentaires", "exportations", "excedent_net", "disponible_apparent_kg_hbt", "taux_couverture_officiel_pct"}),
				    // Toutes les colonnes sont des entiers (milliers de tonnes, kg, %)
				    #"Changed column types" = Table.TransformColumnTypes(#"Kept model columns", List.Transform(Table.ColumnNames(#"Kept model columns"), each {_, Int64.Type}))
				in
				    #"Changed column types"

